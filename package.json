{
    "name":  "my-crossplatform-system",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Production-grade, enterprise-ready cross-platform system with Turborepo, React, Electron, and Expo",
    "packageManager":  "pnpm@12.14.0",
    "scripts":  {
                    "build":  "pnpm --filter @app/web build",
                    "dev":  "pnpm --filter @app/web dev",
                    "lint":  "turbo run lint",
                    "typecheck":  "turbo run typecheck",
                    "dev:web":  "pnpm --filter @app/web dev",
                    "dev:desktop":  "pnpm --filter @app/desktop dev",
                    "dev:mobile":  "pnpm --filter @app/mobile start",
                    "build:web":  "pnpm --filter @app/web build",
                    "build:desktop":  "pnpm --filter @app/desktop build",
                    "build:mobile":  "pnpm --filter @app/mobile build",
                    "clean":  "turbo run clean && rm -rf node_modules",
                    "build:all":  "turbo run build"
                },
    "devDependencies":  {
                            "turbo":  "^2.4.4",
                            "typescript":  "^5.7.3"
                        },
    "workspaces":  [
                       "packages/*",
                       "apps/*"
                   ]
}
